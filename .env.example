# Copie para .env e ajuste. Nunca versione o .env.

# Banco de dados (validação: SQLite em arquivo local; caminho relativo à raiz do projeto)
DATABASE_URL="file:./data/app.db"

# Endereço público da aplicação — usado nos links de convite e de redefinição de senha
APP_URL="http://localhost:3000"

# Fuso horário para exibição de datas
NEXT_PUBLIC_APP_TIMEZONE="America/Sao_Paulo"

# Pasta de destino do npm run backup (opcional)
# BACKUP_DIR="backups"

# Pasta dos arquivos enviados (vídeos, PDFs, imagens). Fora do Git; incluir no backup.
STORAGE_DIR="storage"

# Limites de envio em MB (opcional)
# NEXT_PUBLIC_MAX_VIDEO_MB="2048"
# NEXT_PUBLIC_MAX_PDF_MB="50"
# NEXT_PUBLIC_MAX_IMAGE_MB="10"

# Índice de busca (dado derivado, reconstruível com npm run search:reindex)
# SEARCH_DB="data/search.db"
