# Copie para .env e ajuste. Nunca versione o .env.

# Banco de dados (validação: SQLite em arquivo local; caminho relativo à raiz do projeto)
DATABASE_URL="file:./data/app.db"

# Endereço público da aplicação — usado nos links de convite e de redefinição de senha
APP_URL="http://localhost:3000"

# Fuso horário para exibição de datas
NEXT_PUBLIC_APP_TIMEZONE="America/Sao_Paulo"

# Pasta de destino do npm run backup (opcional)
# BACKUP_DIR="backups"
