// Modelo de dados — Fases 1 (acesso), 2 (conteúdo), 3 (trilhas) e 4 (gamificação).
// Documentação: docs/MODELO-DE-DADOS.md
// Validação em SQLite; o schema evita recursos exclusivos do SQLite para migrar a PostgreSQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserStatus {
  INVITED // cadastrado pelo admin, aguardando definir a senha pelo convite
  ACTIVE
  INACTIVE
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // ADMIN, COLABORADOR (futuro: GESTOR_CONTEUDO)
  name        String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // ex.: usuarios.gerenciar
  description String
  roles       RolePermission[]
}

// Futuro: escopo opcional por categoria (gestor de conteúdo de uma área) — ver docs/MODELO-DE-DADOS.md.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique // sempre em minúsculas
  username     String     @unique // identificador de acesso, minúsculas
  department   String?
  jobTitle     String?
  hireDate     DateTime?
  status       UserStatus @default(INVITED)
  passwordHash String?
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdById  String?
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]     @relation("UserCreatedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions          Session[]
  authTokens        AuthToken[]        @relation("TokenOwner")
  issuedTokens      AuthToken[]        @relation("TokenIssuer")
  groups            GroupMember[]
  auditLogs         AuditLog[]
  uploadedFiles     StoredFile[]
  authoredContents  Content[]          @relation("ContentAuthor")
  createdVersions   ContentVersion[]   @relation("VersionCreator")
  publishedVersions ContentVersion[]   @relation("VersionPublisher")
  createdTracks     Track[]
  trackAssignments  TrackAssignment[]  @relation("AssignedUser")
  assignmentsMade   TrackAssignment[]  @relation("AssignedBy")
  enrollments       Enrollment[]
  contentProgress   ContentProgress[]
  completions       CompletionRecord[]
  pointTransactions PointTransaction[] @relation("PointsOwner")
  pointAdjustments  PointTransaction[] @relation("PointsAdjuster")
  achievements      UserAchievement[]
  notifications     Notification[]

  @@index([status])
  @@index([department])
}

model Group {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?
  members          GroupMember[]
  trackAssignments TrackAssignment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model GroupMember {
  groupId String
  userId  String
  addedAt DateTime @default(now())
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// O id é o SHA-256 do token do cookie: o token em si nunca é gravado.
model Session {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime // expiração por inatividade (deslizante)
  absoluteExpiresAt DateTime // limite máximo, não renovável
  lastSeenAt        DateTime @default(now())
  ip                String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([userId])
}

// Convites e redefinições de senha: uso único, só o hash é gravado.
model AuthToken {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  type        AuthTokenType
  userId      String
  user        User          @relation("TokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?         @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, type])
}

// Base para limitar tentativas de login (persistente entre reinícios).
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // e-mail/login informado, em minúsculas
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ex.: usuario.desativado
  entityType String
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Fase 2 — conteúdo
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ContentType {
  VIDEO
  PDF
  IMAGE
  ARTICLE // manual, artigo ou texto explicativo escrito no editor
  FAQ // pergunta (título) e resposta (corpo)
  LINK // recurso externo
}

enum ContentStatus {
  DRAFT // nunca publicado
  PUBLISHED
  ARCHIVED
}

enum VersionStatus {
  DRAFT
  PUBLISHED // versão vigente
  SUPERSEDED // publicada antes, substituída por outra (mantida como histórico)
}

enum FileKind {
  VIDEO
  PDF
  IMAGE
}

// Categorias em dois níveis (categoria > subcategoria), configuráveis pelo administrador.
model Category {
  id          String         @id @default(cuid())
  name        String
  description String?
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryTree")
  position    Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  contents    Content[]
  tracks      Track[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([parentId, name])
  @@index([parentId, position])
}

// Metadados de arquivos. Os bytes ficam no armazenamento (disco local ou S3), nunca no banco.
// Arquivos são imutáveis: substituir um arquivo cria uma nova versão do conteúdo.
model StoredFile {
  id              String   @id @default(cuid())
  storageKey      String   @unique // caminho interno gerado pelo sistema (nunca o nome enviado)
  originalName    String
  mimeType        String
  kind            FileKind
  size            Int
  sha256          String
  durationSeconds Float? // vídeo MP4: lida do próprio arquivo pelo servidor
  uploadedById    String?
  uploadedBy      User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  mainOf      ContentVersion[]
  embeddedIn  ContentVersionAsset[]
  trackCovers Track[]

  @@index([sha256])
}

// Conteúdo único e reutilizável: o mesmo registro serve às trilhas (Fase 3) e à Central de Conhecimento.
model Content {
  id               String             @id @default(cuid())
  type             ContentType
  title            String // espelha a versão vigente (ou o rascunho, se nunca publicado)
  status           ContentStatus      @default(DRAFT)
  categoryId       String?
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inLibrary        Boolean            @default(true) // visível na Central de Conhecimento
  currentVersionId String?            @unique
  currentVersion   ContentVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         ContentVersion[]   @relation("ContentVersions")
  authorId         String?
  author           User?              @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  trackItems       TrackItem[]
  progress         ContentProgress[]
  completions      CompletionRecord[]
  viewCount        Int                @default(0)
  publishedAt      DateTime? // primeira publicação
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, type])
  @@index([categoryId])
}

// Versões imutáveis após publicadas. Editar um conteúdo publicado cria um novo rascunho.
model ContentVersion {
  id                   String                @id @default(cuid())
  contentId            String
  content              Content               @relation("ContentVersions", fields: [contentId], references: [id], onDelete: Cascade)
  currentOf            Content?              @relation("CurrentVersion")
  number               Int
  status               VersionStatus         @default(DRAFT)
  title                String
  description          String?
  body                 Json? // documento do editor (Tiptap)
  bodyHtml             String? // HTML gerado no servidor só com elementos permitidos
  bodyText             String? // texto puro para busca
  fileId               String?
  file                 StoredFile?           @relation(fields: [fileId], references: [id], onDelete: Restrict)
  url                  String?
  durationSeconds      Int? // vídeo: informado pelo navegador no envio (apenas exibição)
  changeNote           String?
  requiresRecompletion Boolean               @default(false) // mudança relevante: exige nova conclusão (Fase 3)
  assets               ContentVersionAsset[]
  progress             ContentProgress[]
  completions          CompletionRecord[]
  createdById          String?
  createdBy            User?                 @relation("VersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedById        String?
  publishedBy          User?                 @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([contentId, number])
  @@index([contentId, status])
}

// Imagens incorporadas no corpo de um artigo (para controlar o acesso a elas).
model ContentVersionAsset {
  versionId String
  fileId    String
  version   ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  file      StoredFile     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([versionId, fileId])
  @@index([fileId])
}

// ---------------------------------------------------------------------------
// Fase 3 — trilhas de aprendizagem
// ---------------------------------------------------------------------------

enum TrackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompletionRule {
  WATCH // vídeo: percentual assistido validado no servidor
  CONFIRM // o colaborador confirma após o tempo mínimo de leitura
  VIEW // abrir já conclui (imagens e links simples)
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum CompletionMethod {
  VIDEO_WATCHED
  CONFIRMED
  VIEWED
}

model Track {
  id                String             @id @default(cuid())
  title             String
  description       String?
  coverFileId       String?
  coverFile         StoredFile?        @relation(fields: [coverFileId], references: [id], onDelete: SetNull)
  categoryId        String?
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status            TrackStatus        @default(DRAFT)
  sequential        Boolean            @default(true) // etapas desbloqueadas em ordem
  isOnboarding      Boolean            @default(false)
  videoThresholdPct Int                @default(90) // % mínimo assistido para concluir vídeo
  minReadSeconds    Int                @default(30) // tempo mínimo antes de confirmar leitura de PDF/artigo
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  modules           TrackModule[]
  assignments       TrackAssignment[]
  enrollments       Enrollment[]
  completions       CompletionRecord[]
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
}

model TrackModule {
  id          String      @id @default(cuid())
  trackId     String
  track       Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  items       TrackItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([trackId, position])
}

// Liga um conteúdo (reutilizável) a uma etapa. O conteúdo não é copiado.
model TrackItem {
  id             String         @id @default(cuid())
  moduleId       String
  module         TrackModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentId      String
  content        Content        @relation(fields: [contentId], references: [id], onDelete: Restrict)
  position       Int
  required       Boolean        @default(true)
  completionRule CompletionRule
  createdAt      DateTime       @default(now())

  @@index([moduleId, position])
  @@index([contentId])
}

// Atribuição direta a uma pessoa ou a um grupo.
model TrackAssignment {
  id           String    @id @default(cuid())
  trackId      String
  track        Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  @@unique([trackId, userId])
  @@unique([trackId, groupId])
}

// Matrícula materializada: a pessoa tem a trilha. Preservada mesmo se a atribuição sair.
model Enrollment {
  id             String           @id @default(cuid())
  trackId        String
  track          Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(NOT_STARTED)
  startedAt      DateTime?
  completedAt    DateTime?
  lastItemId     String? // último item aberto (onde parou)
  lastActivityAt DateTime?
  removedAt      DateTime? // atribuição retirada antes da conclusão
  createdAt      DateTime         @default(now())

  @@unique([trackId, userId])
  @@index([userId])
}

// Progresso de uma pessoa em uma versão de conteúdo (independe da trilha).
model ContentProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId        String
  content          Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentVersionId String
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(IN_PROGRESS)
  positionSeconds  Float          @default(0) // retomada do vídeo
  durationSeconds  Float?
  watchedRanges    Json? // intervalos assistidos validados [[início, fim], ...]
  watchedSeconds   Float          @default(0)
  openedAt         DateTime       @default(now())
  lastHeartbeatAt  DateTime?
  lastActivityAt   DateTime       @default(now())
  completedAt      DateTime?

  @@unique([userId, contentVersionId])
  @@index([userId, contentId])
}

// Histórico de aprendizagem: somente inserção, nunca alterado nem apagado.
model CompletionRecord {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId        String
  content          Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentVersionId String
  contentVersion   ContentVersion   @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  trackId          String?
  track            Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  method           CompletionMethod
  evidence         Json?
  completedAt      DateTime         @default(now())

  @@unique([userId, contentVersionId])
  @@index([userId, contentId])
}

// ---------------------------------------------------------------------------
// Fase 4 — gamificação
// ---------------------------------------------------------------------------

enum PointEvent {
  CONTENT_VIDEO // concluir um vídeo
  CONTENT_READING // concluir PDF, manual/artigo ou FAQ
  CONTENT_OTHER // concluir imagem ou link
  MODULE_COMPLETED // finalizar uma etapa
  TRACK_COMPLETED // finalizar uma trilha
  ACHIEVEMENT // bônus de conquista
  MANUAL_ADJUSTMENT // ajuste feito por administrador, com motivo
}

// Níveis configuráveis por pontos acumulados.
model Level {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String
  minPoints Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Valor de cada evento que gera pontos.
model PointRule {
  id        String     @id @default(cuid())
  event     PointEvent @unique
  points    Int
  active    Boolean    @default(true)
  updatedAt DateTime   @updatedAt
}

// Livro-razão de pontos: somente inserção. A restrição única impede pontuar duas
// vezes o mesmo fato (mesmo conteúdo, etapa, trilha ou conquista).
model PointTransaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("PointsOwner", fields: [userId], references: [id], onDelete: Cascade)
  event       PointEvent
  points      Int
  sourceType  String // conteudo, etapa, trilha, conquista, ajuste
  sourceId    String
  description String
  createdById String?
  createdBy   User?      @relation("PointsAdjuster", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([userId, event, sourceType, sourceId])
  @@index([userId, createdAt])
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String
  criteria    Json // { tipo: CONTENTS_COMPLETED | TRACKS_COMPLETED | ONBOARDING_COMPLETED | TRACK_COMPLETED, ... }
  points      Int               @default(0)
  active      Boolean           @default(true)
  users       UserAchievement[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model UserAchievement {
  userId        String
  achievementId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedAt     DateTime    @default(now())

  @@id([userId, achievementId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // nivel, conquista, trilha
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
